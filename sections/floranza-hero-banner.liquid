{%- comment -%}
  Floranza Custom Hero Banner (Venetto Design Aesthetic)
  Prestige Theme Compatible
{%- endcomment -%}

<div class="floranza-hero-section section-{{ section.id }}" style="background-color: {{ section.settings.bg_color }};">
  <div class="floranza-hero-container">
    <div class="floranza-hero-grid">
      <div class="floranza-hero-content">
        {%- if section.settings.subheading != blank -%}
          <span class="floranza-script-accent">{{ section.settings.subheading }}</span>
        {%- endif -%}
        
        <h1 class="floranza-heading">{{ section.settings.heading }}</h1>
        
        {%- if section.settings.description != blank -%}
          <p class="floranza-body-text">{{ section.settings.description }}</p>
        {%- endif -%}

        {%- if section.settings.button_text != blank -%}
          <div class="floranza-cta-wrap">
            <a href="{{ section.settings.button_link }}" class="floranza-gold-btn">
              {{ section.settings.button_text }}
            </a>
          </div>
        {%- endif -%}
      </div>

      <div class="floranza-hero-visual">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'eager', class: 'floranza-hero-img' }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

<style>
  .section-{{ section.id }} {
    padding: 60px 4%;
    color: {{ section.settings.text_color }};
  }
  .floranza-hero-container {
    max-width: 1400px;
    margin: 0 auto;
  }
  .floranza-hero-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    align-items: center;
    gap: 48px;
  }
  .floranza-script-accent {
    font-family: var(--heading-font-family, serif);
    font-style: italic;
    font-size: 1.25rem;
    color: #C5A059;
    display: block;
    margin-bottom: 12px;
    letter-spacing: 1.5px;
  }
  .floranza-heading {
    font-family: var(--heading-font-family, serif);
    font-size: clamp(2.2rem, 4vw, 3.8rem);
    line-height: 1.15;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin: 0 0 20px 0;
  }
  .floranza-body-text {
    font-family: var(--text-font-family, sans-serif);
    font-size: 1rem;
    line-height: 1.7;
    color: #555555;
    max-width: 480px;
    margin-bottom: 32px;
  }
  .floranza-gold-btn {
    display: inline-block;
    padding: 14px 38px;
    border: 1px solid #C5A059;
    background-color: transparent;
    color: #1A1A1A;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    text-decoration: none;
    transition: all 0.3s ease;
  }
  .floranza-gold-btn:hover {
    background-color: #C5A059;
    color: #FFFFFF;
    border-color: #C5A059;
  }
  .floranza-hero-visual img {
    width: 100%;
    height: auto;
    object-fit: cover;
    display: block;
  }
  @media (max-width: 768px) {
    .floranza-hero-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .floranza-body-text {
      margin-left: auto;
      margin-right: auto;
    }
  }
</style>

{% schema %}
{
  "name": "Floranza Hero Editorial",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner Image"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Tagline / Subheading",
      "default": "Grace meets Fashion"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "THE FLORANZA COLLECTION"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Timeless elegance curated for modern grace. Discover artisanal styles crafted in Kolkata."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Label",
      "default": "EXPLORE COLLECTION"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button URL"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FCFAF6"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1A1A1A"
    }
  ],
  "presets": [
    {
      "name": "Floranza Hero Editorial"
    }
  ]
}
{% endschema %}